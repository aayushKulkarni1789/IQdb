# DB related
POSTGRES_USER=root
POSTGRES_PASSWORD=rootpass
POSTGRES_DB=imagedb
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Model related
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
CLIP_MODEL_PATH=/app/models/clip-32

# Image upload
UPLOAD_ROOT="/app/uploads"
MAX_UPLOAD_BATCH_IMAGES=32
MAX_CLIP_BATCH_IMAGES=32
MAX_IMAGE_SIZE_MB=32

# Cleanup sweep (minutes between passes; 1440 = daily)
SWEEP_INTERVAL_MINUTES=1440

# LLM (OpenAI-compatible, supports llama.cpp or Groq)
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

